{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-render-service.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://your-render-service.onrender.com/socket.io/:path*"
    }
  ]
}
