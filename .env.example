NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Required for authentication
JWT_SECRET=replace_with_a_long_random_secret

# Required for admin protection
# Example: ADMIN_USER_IDS=1,7,12
ADMIN_USER_IDS=

# Recommended for Railway deployment
# Put your frontend domain or Railway app domain here, comma-separated if needed.
CLIENT_ORIGIN=
CORS_ORIGIN=

# MySQL settings
# Use either DB_* or Railway MYSQL* variables.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# Railway MySQL alternative variables
MYSQLHOST=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=
MYSQLPORT=3306

# Optional Railway MySQL aliases used by this project
RAILWAY_MYSQL_HOST=
RAILWAY_MYSQL_USER=
RAILWAY_MYSQL_PASSWORD=
RAILWAY_MYSQL_DATABASE=
RAILWAY_MYSQL_PORT=3306
