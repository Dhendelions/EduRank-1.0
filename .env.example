NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Required for authentication
JWT_SECRET=replace-with-a-long-random-secret

# Required for admin protection
# Example: ADMIN_USER_IDS=1,7,12
ADMIN_USER_IDS=

# Frontend / CORS
# Local frontend example: http://localhost:5173
# Production frontend example: https://your-project.vercel.app
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# MySQL settings
# Use either DB_* or Railway MYSQL* variables.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=edurank
DB_PORT=3306

# Railway MySQL alternative variables
MYSQLHOST=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=
MYSQLPORT=3306

# Optional Railway MySQL aliases used by this project
RAILWAY_MYSQL_HOST=
RAILWAY_MYSQL_USER=
RAILWAY_MYSQL_PASSWORD=
RAILWAY_MYSQL_DATABASE=
RAILWAY_MYSQL_PORT=3306

# Optional full database URL
DATABASE_URL=
